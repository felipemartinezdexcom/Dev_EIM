  "propConfig": {
    "custom.dbs": {
      "binding": {
        "config": {
          "expression": "now(0)"
        },
        "transforms": [
          {
            "code": "\tdbs\u003dsystem.db.getConnections()\n\tdata\u003d[]\n\tfor index in range(dbs.getRowCount()):\n\t\toption\u003d{\"value\":dbs[index][0],\"label\":dbs[index][0]}\n\t\tdata.append(option)\n\treturn data",
            "type": "script"
          }
        ],
        "type": "expr"
      }
    },
    "custom.dbstatus": {
      "binding": {
        "config": {
          "expression": "now(5000)"
        },
        "transforms": [
          {
            "code": "\tdbstatus\u003dsystem.db.getConnectionInfo(\"API_Configurations\")\n\t\n\t\n\treturn dbstatus.getValueAt(0,3)",
            "type": "script"
          }
        ],
        "type": "expr"
      }
    },
