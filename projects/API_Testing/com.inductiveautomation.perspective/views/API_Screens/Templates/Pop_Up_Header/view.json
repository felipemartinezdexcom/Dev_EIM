{
  "custom": {},
  "params": {
    "data": {
      "icon": "material/info",
      "level": "success",
      "message": "value",
      "title": "value"
    }
  },
  "propConfig": {
    "params.data": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 70,
      "width": 306
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "Icon"
        },
        "position": {
          "basis": "60px"
        },
        "propConfig": {
          "props.path": {
            "binding": {
              "config": {
                "path": "view.params.data.icon"
              },
              "type": "property"
            }
          }
        },
        "type": "ia.display.icon"
      },
      {
        "meta": {
          "name": "Spacer_0"
        },
        "position": {
          "grow": 1
        },
        "type": "ia.display.label"
      },
      {
        "meta": {
          "name": "Label"
        },
        "position": {
          "grow": 1
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "path": "view.params.data.title"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "style": {
            "classes": "Control/Control/Labels Tables/Col_Headers"
          },
          "textStyle": {
            "textAlign": "center"
          }
        },
        "type": "ia.display.label"
      },
      {
        "meta": {
          "name": "Spacer"
        },
        "position": {
          "grow": 1.5
        },
        "type": "ia.display.label"
      }
    ],
    "meta": {
      "name": "root"
    },
    "propConfig": {
      "props.style.classes": {
        "binding": {
          "config": {
            "path": "view.params.data.level"
          },
          "transforms": [
            {
              "code": "\tclasses \u003d []\n\tif value\u003d\u003d\"success\":\n\t    classes.append(\"Alert_Levels/success\")\n\telif value\u003d\u003d\"info\":\n\t    classes.append(\"Alert_Levels/info\")\n\telif value\u003d\u003d\"warning\":\n\t    classes.append(\"Alert_Levels/warning\")\t   \n\telif value\u003d\u003d\"error\":\n\t    classes.append(\"Alert_Levels/error\")\n\telif value\u003d\u003d\"popup\":\n\t    classes.append(\"Alert_Levels/popup\")\n\treturn \" \".join(classes)",
              "type": "script"
            }
          ],
          "type": "property"
        }
      }
    },
    "props": {
      "justify": "space-between",
      "style": {
        "gap": 10
      }
    },
    "type": "ia.container.flex"
  }
}