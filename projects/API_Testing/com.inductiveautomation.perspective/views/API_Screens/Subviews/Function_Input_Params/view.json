                  "config": {
                    "script": "\t#dbstatus\u003dself.session.custom.dbstatus\n\tdbstatus\u003d\"Valid\"\n\tmessageboxparams\u003d{\"data\":{\"icon\": \"material/info\",\n\t\t\t  \"title\": \"\",\n\t\t\t  \"level\": \"\",\n\t\t\t  \"message\": \"\"\n\t\t\t  }\n\t\t\t  }\n\t\n\t\n\tif dbstatus\u003d\u003d\"Valid\":\n\t\tfunction_id\u003dself.view.params.value.function_id\n\t\tparams\u003d{\"function_id\":function_id}\n\t\tsystem.perspective.openPopup(\"AddParams\", \"API_Screens/Pop_Ups/Add_Function_Params_Input\",params, showCloseIcon\u003dFalse, draggable\u003dFalse, resizable\u003dFalse, modal\u003dTrue, overlayDismiss\u003dTrue)\n\telse:\n\t\t\n\t\tmessageboxparams[\"data\"][\"title\"]\u003d \"Data-Base Connection Error\"\n\t\tmessageboxparams[\"data\"][\"level\"]\u003d \"error\"\n\t\tmessageboxparams[\"data\"][\"message\"]\u003d \"The database connection is not valid.\"\n\t\t\t\t\t\t  \n\t\tsystem.perspective.openPopup(\"dbError\", \"API_Screens/Pop_Ups/Message_Box\",messageboxparams, showCloseIcon\u003dFalse, draggable\u003dFalse, resizable\u003dFalse, modal\u003dTrue, overlayDismiss\u003dTrue)\n\t\t\t\t\t\t  \n\t\n\t\n\t\n\t\n"
