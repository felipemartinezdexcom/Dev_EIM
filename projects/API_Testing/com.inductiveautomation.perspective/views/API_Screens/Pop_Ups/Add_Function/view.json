tion ---{0}--- was successfully added to the config file.\".format(function_name)\n\t\t#messageboxparams[\u0027data\u0027][\u0027title\u0027]\u003d\"Function Added\"\n\t\t#messageboxparams[\u0027data\u0027][\"level\"]\u003d \"success\"\n\t\t#messageboxparams[\u0027data\u0027][\"icon\"]\u003d \"material/add_circle\"\n\n\n\t\tsystem.perspective.sendMessage(\"tablerefresh\")\t\t\n\t\tpopup_params\u003d{\"function_id\":function_id[0][\u0027ID\u0027],\n\t\t\t\t\t  \"function_name\":function_name}\n\t\tsystem.perspective.openPopup(\"AddInputParams\", \"API_Screens/Pop_Ups/Add_Function_Params_Input\",popup_params, showCloseIcon\u003dFalse, draggable\u003dFalse, resizable\u003dFalse, modal\u003dTrue, overlayDismiss\u003dTrue)\n\n\t\t##logEvent\n\t\tlogparams\u003d{\"username\":username,\n\t\t\t\t   \"event_type\":\"Add\",\n\t\t\t\t   \"before_change\":None,\n\t\t\t\t   \"after_change\":str(parameters),\n\t\t\t\t   \"description\":\"added new function {}\".format(function_name)}\n\t\tAPI.Functions.log_activity(logparams)\n\t\t#system.perspective.openPopup(\"msg1\", \"API_Screens/Pop_Ups/Message_Box\",messageboxparams, showCloseIcon\u003dFalse, draggable\u003dFalse, resizable\u003dFalse, modal\u003dTrue, overlayDismiss\u003dTrue)\n\t\tsystem.perspective.closePopup(\"ASP\")\n"
                      },
