                      "config": {
                        "script": "\n\tusername\u003dself.session.props.auth.user.userName\n\tequipment_name_constant\u003dself.parent.parent.getChild(\"Equipment Name Constant\").getChild(\"TextField\").props.text\n\tdescription\u003dself.parent.parent.getChild(\"Equipment Description\").getChild(\"TextField\").props.text\n\tstart\u003dself.parent.parent.getChild(\"Equipment Name Range\").getChild(\"Range\").getChild(\"Start\").props.value\n\tend\u003dself.parent.parent.getChild(\"Equipment Name Range\").getChild(\"Range\").getChild(\"End\").props.value\n\n\tmessageboxparams\u003d{\"data\":{\"icon\": \"material/info\",\n\t\t\t\t\t\t  \"title\": \"\",\n\t\t\t\t\t\t  \"level\": \"\",\n\t\t\t\t\t\t  \"message\": \"\"}}\n\tnot_added\u003d[]\t\n\tadded\u003d[]\n\tif  equipment_name_constant!\u003d\"\" and start!\u003d\"\" and end!\u003d\"\" :\n\t\t\n\t\trange1\u003d[start,end]\n\t\tfor value in range(min(range1),max(range1)+1):\n\t\t\tequipment_name\u003d\"{0}{1:03d}\".format(equipment_name_constant,value)\n\n\t\t\tparams\u003d{\"equipment_name\":equipment_name,\n\t\t\t\t\t\"description\": description,\n\t\t\t\t\t\"created_by\":username}\n\t\t\t\t\t\n\t\t\tadd_equipment_result\u003dsystem.db.execQuery(\"API/Equipment_Manager/Equipment/Add\", params)\n\t\t\tif add_equipment_result[0][0]\u003d\u003d0:\n\t\t\t\tnot_added.append(equipment_name)\n\t\t\telse:\n\t\t\t\t\n\t\t\t\tadded.append([equipment_name,description])\n\t\t\t\t\n\t\t##logEvent\n\t\tif len(added)\u003e0:\n\t\t\tlogparams\u003d{\"username\":username,\n\t\t\t\t   \"event_type\":\"Add\",\n\t\t\t\t   \"before_change\":None,\n\t\t\t\t   \"after_change\":str(added),\n\t\t\t\t   \"description\":\"Add Equipment\"}\n\t\t\n\t\t\tAPI.Functions.log_activity(logparams)\n\t\tsystem.perspective.closePopup(\"\")\t\n\t\t\n\t\tif len(not_added)\u003e0:\n\t\t\tmessageboxparams[\u0027data\u0027][\u0027message\u0027]\u003d\"The items in the list {0} already exist in the database.\".format(str(not_added))\n\t\t\tmessageboxparams[\u0027data\u0027][\u0027title\u0027]\u003d\"Repeated Equipment Names\"\n\t\t\tmessageboxparams[\u0027data\u0027][\"level\"]\u003d \"warning\"\t\t\t\t\t\t\t\t  \n\t\t\tsystem.perspective.openPopup(\"msg1\", \"API_Screens/Pop_Ups/Message_Box\",messageboxparams, showCloseIcon\u003dFalse, draggable\u003dFalse, resizable\u003dFalse, modal\u003dTrue, overlayDismiss\u003dTrue)\n\t\t\t\t\n\t\tsystem.perspective.sendMessage(\"tablerefresh\")\n\t\n\t\t\t\n\telse:\n\t\t\tmessageboxparams[\u0027data\u0027][\u0027message\u0027]\u003d\"You must enter an equipment constant, start and end range.\"\n\t\t\tmessageboxparams[\u0027data\u0027][\u0027title\u0027]\u003d\"Missing Fields\"\n\t\t\tmessageboxparams[\u0027data\u0027][\"level\"]\u003d \"warning\"\t\t\t\t\t\t\t\t  \n\t\t\tsystem.perspective.openPopup(\"msg1\", \"API_Screens/Pop_Ups/Message_Box\",messageboxparams, showCloseIcon\u003dFalse, draggable\u003dFalse, resizable\u003dFalse, modal\u003dTrue, overlayDismiss\u003dTrue)\n\t\t\n\t\t\n\t\n\t\t\n"
