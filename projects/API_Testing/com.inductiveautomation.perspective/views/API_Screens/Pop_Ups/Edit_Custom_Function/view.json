                        "script": "\n\tusername\u003dself.session.props.auth.user.userName\n\tfunction_id\u003dself.view.params.row_data[\u0027function_id\u0027]\n\tfunction_name\u003dself.parent.parent.getChild(\"Function Name\").getChild(\"TextField\").props.text\n\tcustom_function_name\u003dself.parent.parent.getChild(\"Custom_Function\").getChild(\"Dropdown\").props.value\n\trow_data\u003dself.view.params.row_data\n\t\n\t\"\"\"messageboxparams\u003d{\"data\":{\"icon\": \"material/info\",\n\t\t\t\t\t\t  \"title\": \"\",\n\t\t\t\t\t\t  \"level\": \"\",\n\t\t\t\t\t\t  \"message\": \"\"}}\"\"\"\n\n\n\t\n\tparameters\u003d{\"function_name\":function_name,\n\t\t\t\t\"function_id\":function_id,\n\t\t\t\t\"custom_function_name\":custom_function_name,\n\t\t\t\t\"username\":username}\n\tresponse\u003dsystem.db.execUpdate(\"API/Equipment_Manager/Functions/Update_Custom_Function\", parameters)\n\t\n\t##logEvent\n\tlogparams\u003d{\"username\":username,\n\t\t\t   \"event_type\":\"Edit\",\n\t\t\t   \"before_change\":str(row_data)[17:],\n\t\t\t   \"after_change\":str(parameters),\n\t\t\t   \"description\":\"edit custom function\"}\n\tAPI.Functions.log_activity(logparams)\n\t\n\t\n\tsystem.perspective.sendMessage(\"tablerefresh\")\n\tsystem.perspective.closePopup(\"\")"
                      },
