                          "database_schema": "{.../Database/Database Schema/TextField.props.text}",
                          "func_name": "{.../Function Name/TextField.props.text}",
                          "sys_interface": "{.../Sys Interface/Dropdown.props.value}"
                        },
                        "waitOnAll": true
                      },
                      "transforms": [
                        {
                          "code": "\tif len(value[\u0027func_name\u0027])\u003e5:\n\t\tif value[\u0027sys_interface\u0027]\u003d\u003d\u0027Database\u0027:\n\t\t\tif len(value[\u0027database_name\u0027]) and len(value[\u0027database_schema\u0027])\u003e3:\n\t\t\t\treturn True\n\t\t\telse:\n\t\t\t\treturn False\n\t\telif value[\u0027sys_interface\u0027]\u003d\u003d\u0027Custom Function\u0027:\n\t\t\tif len(value[\u0027custom_function_name\u0027])\u003e5:\n\t\t\t\treturn True\n\t\t\telse:\n\t\t\t\treturn False\n\telse:\n\t\treturn False",
                          "type": "script"
                        }
                      ],
                      "type": "expr-struct"
                    }
