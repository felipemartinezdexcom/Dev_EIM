                "propConfig": {
                  "props.options": {
                    "binding": {
                      "config": {
                        "expression": "now(0)"
                      },
                      "transforms": [
                        {
                          "code": "\timport types\n\t\n\timport API.Function_Calls\n\t\n\tavailable_functions \u003d []\n\t\n\t# Get the class\n\tcls \u003d API.Function_Calls.CustomFunctions\n\t\n\t# Iterate through the class attributes\n\tfor attribute_name in dir(cls):\n\t\tattribute_value \u003d getattr(cls, attribute_name)\n\t\n\t\tif attribute_name.startswith(\"Custom\"):\n\t\t    newrow \u003d {\n\t\t        \"label\": attribute_name,\n\t\t        \"value\": attribute_name\n\t\t    }\n\t\t    available_functions.append(newrow)\n\t\n\treturn available_functions",
                          "type": "script"
                        }
                      ],
                      "type": "expr"
                    }
                  },
                  "props.value": {
                    "binding": {
                      "config": {
                        "path": "view.params.row_data[\u0027custom_function_name\u0027]"
