                          "config": {
                            "script": "\n\tusername\u003dself.session.props.auth.user.userName\n\tfunction_name\u003dself.parent.parent.getChild(\"Function Name\").getChild(\"TextField\").props.text\n\tsys_interface\u003dself.parent.parent.getChild(\"Sys Interface\").getChild(\"Dropdown\").props.value\n\tdatabase_name\u003dself.parent.parent.getChild(\"Database\").getChild(\"Database Name\").getChild(\"TextField\").props.text\n\tdatabase_schema\u003dself.parent.parent.getChild(\"Database\").getChild(\"Database Schema\").getChild(\"TextField\").props.text\n\tcustom_function_name\u003dself.parent.parent.getChild(\"Custom_Function\").getChild(\"Dropdown\").props.value\n\tmessageboxparams\u003d{\"data\":{\"icon\": \"material/info\",\n\t\t\t\t\t\t  \"title\": \"\",\n\t\t\t\t\t\t  \"level\": \"\",\n\t\t\t\t\t\t  \"message\": \"\"}}\n\n\t#if function_name!\u003d None or function_name!\u003d\"\":\n\t\t\n\tparameters\u003d{\"function_name\":function_name,\n\t\t\t\t\"username\":username,\n\t\t\t\t\"sys_interface\":sys_interface,\n\t\t\t\t\"custom_function_name\":custom_function_name,\n\t\t\t\t\"database_name\":database_name,\n\t\t\t\t\"database_schema\":database_schema}\n\tresponse\u003dsystem.db.execUpdate(\"API/Configurations/Add_Function_No_Ret\", parameters)\n\t\n\tif response\u003d\u003d0:\n\t\t\n\t\tmessageboxparams[\u0027data\u0027][\u0027message\u0027]\u003d\"Another store procedure with the same name was found in the config file. Please add a new name.\"\n\t\tmessageboxparams[\u0027data\u0027][\u0027title\u0027]\u003d\"Duplicated Store Procedure\"\n\t\tmessageboxparams[\u0027data\u0027][\"level\"]\u003d \"warning\"\n\n\t\t\n\t\t\t\t\t\t\t\t  \n\t\tsystem.perspective.openPopup(\"msg1\", \"API_Screens/Pop_Ups/Message_Box\",messageboxparams, showCloseIcon\u003dFalse, draggable\u003dFalse, resizable\u003dFalse, modal\u003dTrue, overlayDismiss\u003dTrue)\n\t\t\t\n\telif response\u003d\u003d1:\n\t\tmessageboxparams[\u0027data\u0027][\u0027message\u0027]\u003d\"The Store Produre ---{0}--- was successfully added to the config file.\".format(function_name)\n\t\tmessageboxparams[\u0027data\u0027][\u0027title\u0027]\u003d\"Store Procedure Added\"\n\t\tmessageboxparams[\u0027data\u0027][\"level\"]\u003d \"success\"\n\t\tmessageboxparams[\u0027data\u0027][\"icon\"]\u003d \"material/add_circle\"\n\n\n\t\tsystem.perspective.sendMessage(\"tablerefresh\")\t\t\t\t\t  \n\t\tsystem.perspective.openPopup(\"msg1\", \"API_Screens/Pop_Ups/Message_Box\",messageboxparams, showCloseIcon\u003dFalse, draggable\u003dFalse, resizable\u003dFalse, modal\u003dTrue, overlayDismiss\u003dTrue)\n\t\tsystem.perspective.closePopup(\"ASP\")\n"
                          },
