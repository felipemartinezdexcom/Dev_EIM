{
  "custom": {},
  "params": {
    "selected_rows": "value"
  },
  "propConfig": {
    "params.selected_rows": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 492,
      "width": 508
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "Header"
        },
        "position": {
          "shrink": 0
        },
        "props": {
          "params": {
            "data": {
              "icon": "material/delete",
              "level": "error",
              "message": "",
              "title": "Delete Function(s)"
            }
          },
          "path": "API_Screens/Templates/Pop_Up_Header",
          "useDefaultViewHeight": true
        },
        "type": "ia.display.view"
      },
      {
        "children": [
          {
            "meta": {
              "name": "TextArea"
            },
            "position": {
              "grow": 1
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "config": {
                    "path": "view.params.selected_rows"
                  },
                  "transforms": [
                    {
                      "code": "\tselected_functions\u003d[]\n\tfor row in value:\n\t\tselected_functions.append(row[\u0027function_name\u0027])\n\t\t\n\treturn \"Are you sure you want to delete the selected functions: {0}? Once deleted, all the input parameters assigned to these functions will also be removed in cascade.\".format(str(selected_functions))",
                      "type": "script"
                    }
                  ],
                  "type": "property"
                }
              }
            },
            "props": {
              "style": {
                "textAlign": "center"
              }
            },
            "type": "ia.input.text-area"
          }
        ],
        "meta": {
          "name": "Content"
        },
        "position": {
          "basis": "160px",
          "grow": 1
        },
        "props": {
          "direction": "column",
          "justify": "space-around"
        },
        "type": "ia.container.flex"
      },
      {
        "children": [
          {
            "events": {
              "dom": {
                "onClick": {
                  "config": {
                    "script": "\tusername\u003dself.session.props.auth.user.userName\n\tselected_rows\u003dself.view.params.selected_rows\n\t\n\t\n\t\n\tfor function in selected_rows:\n\t\t\tparams\u003d{\"function_id\":function[\u0027function_id\u0027]}\n\t\t\tsystem.db.execUpdate(\"API/Configurations/Delete_Function\", params)\n\t\t\tsystem.db.execUpdate(\"API/Configurations/Delete_Param_Function\", params)\n\t\t\t\n\t##logEvent\n\t\n\tfiltered_selected_rows\u003d[]\n\tfor row in selected_rows:\n\t\tnew_row\u003d{\"function_name\":row[\u0027function_name\u0027],\n\t\t\t\t\"sys_interface\":row[\u0027sys_interface\u0027],\n\t\t\t\t\"custom_function_name\":row[\u0027custom_function_name\u0027],\n\t\t\t\t\"database_name\":row[\u0027database_name\u0027],\n\t\t\t\t\"database_schema\":row[\u0027database_schema\u0027]\n\t\t\t\t}\n\t\tfiltered_selected_rows.append(new_row)\n\t\n\t\n\tlogparams\u003d{\"username\":username,\n\t\t\t   \"event_type\":\"Delete\",\n\t\t\t   \"before_change\":str(filtered_selected_rows),\n\t\t\t   \"after_change\":None,\n\t\t\t   \"description\":\"Deleted many functions **Open Popup to see the list\"}\n\tAPI.Functions.log_activity(logparams)\n\t\t\t\t\n\n\tsystem.perspective.sendMessage(\"tablerefresh\")\n\tsystem.perspective.closePopup(\"\")"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            },
            "meta": {
              "name": "yes"
            },
            "position": {
              "basis": "100px"
            },
            "props": {
              "style": {
                "classes": "Buttons/Classic"
              },
              "text": "yes"
            },
            "type": "ia.input.button"
          },
          {
            "events": {
              "dom": {
                "onClick": {
                  "config": {
                    "script": "\tsystem.perspective.closePopup(\"\")\n\t"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            },
            "meta": {
              "name": "no"
            },
            "position": {
              "basis": "100px"
            },
            "props": {
              "style": {
                "classes": "Buttons/Classic"
              },
              "text": "No"
            },
            "type": "ia.input.button"
          }
        ],
        "meta": {
          "name": "Buttons"
        },
        "position": {
          "basis": "35px",
          "shrink": 0
        },
        "props": {
          "justify": "center",
          "style": {
            "gap": 20,
            "marginBottom": 20,
            "marginLeft": 10,
            "marginRight": 10,
            "marginTop": 20
          }
        },
        "type": "ia.container.flex"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "column",
      "style": {
        "classes": "Edges/Boxes_Radious Effects/Fade-In Frames/Standard1"
      }
    },
    "type": "ia.container.flex"
  }
}