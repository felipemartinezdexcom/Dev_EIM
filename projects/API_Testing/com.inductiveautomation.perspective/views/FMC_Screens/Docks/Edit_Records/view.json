            "type": "ia.container.flex"
          },
          {
            "children": [
              {
                "events": {
                  "dom": {
                    "onClick": {
                      "config": {
                        "script": "\t\t\n\tEquipmentPackageId\u003dself.parent.parent.getChild(\"Equipment Package Id\").getChild(\"TextField\").props.text\n\tPackageContent\u003dself.parent.parent.getChild(\"Package Content\").getChild(\"RadioGroup\").props.value\n\tQuality\u003dself.parent.parent.getChild(\"Quality Disposition\").getChild(\"RadioGroup\").props.value\n\tRejectCode\u003dself.parent.parent.getChild(\"Reject Codes\").getChild(\"Dropdown\").props.value\n\tContent\u003dself.parent.parent.getChild(\"Content\").getChild(\"TextArea\").props.text\n\tselectedRow\u003dself.view.params.rowIndex\n\n\t\n\t##Split all comma separated Transactions\n\t#cleanedContent\u003dContent.replace(\"\\n\",\"\")\n\t#TXidsSplit\u003dcleanedContent.split(\u0027,\u0027)\n\t##Split all comma separated Transactions\n\t\n\tTXidsSplit\u003dContent.split(\u0027\\n\u0027)\n\t\n\t\n\t##Build Content Dictionary\n\tdatadict\u003d{\"PackageContents\":{PackageContent:TXidsSplit},\"RejectCode\":RejectCode,\"Result\":1,\"EquipmentPackageID\":EquipmentPackageId}\n\t\n\t\n\n\t\n\tself.session.custom.Records[selectedRow]\u003ddatadict\n\t\n\t##refresh table\n\trefreshState\u003dself.session.custom.RefreshCommands.CreatePackagingRecordTable\n\tself.session.custom.RefreshCommands.CreatePackagingRecordTable\u003dnot refreshState\n\t\n\t##ClearData\n\t#self.parent.parent.getChild(\"Equipemnt\").getChild(\"TextField\").props.text\u003d\"\"\n\t#self.parent.parent.getChild(\"Quality Disposition\").getChild(\"RadioGroup\").props.value\u003d1\n\t#self.parent.parent.getChild(\"TXIDs\").getChild(\"TextArea\").props.text\u003d\"\"\n\t"
                      },
                      "scope": "G",
                      "type": "script"
                    }
