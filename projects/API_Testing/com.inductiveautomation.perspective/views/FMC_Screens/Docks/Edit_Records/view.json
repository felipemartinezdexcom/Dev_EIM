                      },
                      "transforms": [
                        {
                          "code": "\tstrData\u003d\"\"\n\t\n\tlenTransactions\u003dlen(value)\n\tcounter\u003d0\n\tfor transaction in value:\n\t\tif counter!\u003d(lenTransactions-1)  and ((counter+1)%3!\u003d0) :\n\t\t\tstrData+\u003dtransaction+\"\\n\"\n\t\telif counter!\u003d(lenTransactions-1)  and ((counter+1)%3\u003d\u003d0) :\n\t\t\tstrData+\u003dtransaction+\"\\n\"\n\t\telif counter\u003d\u003d(lenTransactions-1):\n\t\t\tstrData+\u003dtransaction\n\t\tcounter+\u003d1\n\t\t\n\t\t\n\treturn strData\n\t\n\t",
                          "type": "script"
                        }
                      ],
                      "type": "property"
                    }
                  }
                },
                "type": "ia.input.text-area"
              }
            ],
