                "onClick": {
                  "config": {
                    "script": "\timport time\n\t##Reset Warning Labels\n\tself.parent.parent.getChild(\"Wrapper\").getChild(\"Col2\").getChild(\"Warning Labels\").getChild(\"UserName\").position.display\u003dFalse\n\tself.parent.parent.getChild(\"Wrapper\").getChild(\"Col2\").getChild(\"Warning Labels\").getChild(\"Cartoner SWName\").position.display\u003dFalse\n\tself.parent.parent.getChild(\"Wrapper\").getChild(\"Col2\").getChild(\"Warning Labels\").getChild(\"Cartoner SWRev\").position.display\u003dFalse\n\tself.parent.parent.getChild(\"Wrapper\").getChild(\"Col2\").getChild(\"Warning Labels\").getChild(\"DB SWName\").position.display\u003dFalse\n\tself.parent.parent.getChild(\"Wrapper\").getChild(\"Col2\").getChild(\"Warning Labels\").getChild(\"DB SWRev\").position.display\u003dFalse\n\tself.parent.parent.getChild(\"Wrapper\").getChild(\"Col2\").getChild(\"Warning Labels\").getChild(\"OPC SWName\").position.display\u003dFalse\n\tself.parent.parent.getChild(\"Wrapper\").getChild(\"Col2\").getChild(\"Warning Labels\").getChild(\"OPC SWRev\").position.display\u003dFalse\n\tself.parent.parent.getChild(\"Wrapper\").getChild(\"Col2\").getChild(\"Warning Labels\").getChild(\"Case SWName\").position.display\u003dFalse\n\tself.parent.parent.getChild(\"Wrapper\").getChild(\"Col2\").getChild(\"Warning Labels\").getChild(\"Case SWRev\").position.display\u003dFalse\n\t\n\t\n\t##Gather Data\n\tUserName\u003dself.parent.parent.getChild(\"Wrapper\").getChild(\"Col1\").getChild(\"Username\").getChild(\"TextField\").props.text\n\tCartonerSWName\u003dself.parent.parent.getChild(\"Wrapper\").getChild(\"Col1\").getChild(\"SWName1\").getChild(\"TextField\").props.text\n\tCartonerSWRev\u003dself.parent.parent.getChild(\"Wrapper\").getChild(\"Col1\").getChild(\"SWRev1\").getChild(\"TextField\").props.text\n\tDBSWName\u003dself.parent.parent.getChild(\"Wrapper\").getChild(\"Col1\").getChild(\"SWName2\").getChild(\"TextField\").props.text\n\tDBSWRev\u003dself.parent.parent.getChild(\"Wrapper\").getChild(\"Col1\").getChild(\"SWRev2\").getChild(\"TextField\").props.text\n\tOPCSWName\u003dself.parent.parent.getChild(\"Wrapper\").getChild(\"Col2\").getChild(\"OPCRouterSWName\").getChild(\"TextField\").props.text\n\tOPCSWRev\u003dself.parent.parent.getChild(\"Wrapper\").getChild(\"Col2\").getChild(\"OPCRouterSWRev\").getChild(\"TextField\").props.text\n\tCaseSWName\u003dself.parent.parent.getChild(\"Wrapper\").getChild(\"Col2\").getChild(\"CasePackerVMSProgramSWName\").getChild(\"TextField\").props.text\n\tCaseSWRev\u003dself.parent.parent.getChild(\"Wrapper\").getChild(\"Col2\").getChild(\"CasePackerVMSProgramSWRev\").getChild(\"TextField\").props.text\n\t\n\t##Data Inspection\n\tInspectionResult\u003d[0,0,0,0,0,0,0,0,0]\n\t\n\tif UserName\u003d\u003dNone or UserName\u003d\u003d\"\":\n\t\tself.parent.parent.getChild(\"Wrapper\").getChild(\"Col2\").getChild(\"Warning Labels\").getChild(\"UserName\").position.display\u003dTrue\n\telse:\n\t\tInspectionResult[0]\u003d1\n\tif CartonerSWName\u003d\u003dNone or CartonerSWName\u003d\u003d\"\":\n\t\tself.parent.parent.getChild(\"Wrapper\").getChild(\"Col2\").getChild(\"Warning Labels\").getChild(\"Cartoner SWName\").position.display\u003dTrue\n\telse:\n\t\tInspectionResult[1]\u003d1\n\tif CartonerSWRev\u003d\u003dNone or CartonerSWRev\u003d\u003d\"\":\n\t\tself.parent.parent.getChild(\"Wrapper\").getChild(\"Col2\").getChild(\"Warning Labels\").getChild(\"Cartoner SWRev\").position.display\u003dTrue\n\telse:\n\t\tInspectionResult[2]\u003d1\n\tif DBSWName\u003d\u003dNone or DBSWName\u003d\u003d\"\":\n\t\tself.parent.parent.getChild(\"Wrapper\").getChild(\"Col2\").getChild(\"Warning Labels\").getChild(\"DB SWName\").position.display\u003dTrue\n\telse:\n\t\tInspectionResult[3]\u003d1\n\tif DBSWRev\u003d\u003dNone or DBSWRev\u003d\u003d\"\":\n\t\tself.parent.parent.getChild(\"Wrapper\").getChild(\"Col2\").getChild(\"Warning Labels\").getChild(\"DB SWRev\").position.display\u003dTrue\n\telse:\n\t\tInspectionResult[4]\u003d1\n\tif OPCSWName\u003d\u003dNone or OPCSWName\u003d\u003d\"\":\n\t\tself.parent.parent.getChild(\"Wrapper\").getChild(\"Col2\").getChild(\"Warning Labels\").getChild(\"OPC SWName\").position.display\u003dTrue\n\telse:\n\t\tInspectionResult[5]\u003d1\n\tif OPCSWRev\u003d\u003dNone or OPCSWRev\u003d\u003d\"\":\n\t\tself.parent.parent.getChild(\"Wrapper\").getChild(\"Col2\").getChild(\"Warning Labels\").getChild(\"OPC SWRev\").position.display\u003dTrue\n\telse:\n\t\tInspectionResult[6]\u003d1\n\tif CaseSWName\u003d\u003dNone or CaseSWName\u003d\u003d\"\":\n\t\tself.parent.parent.getChild(\"Wrapper\").getChild(\"Col2\").getChild(\"Warning Labels\").getChild(\"Case SWName\").position.display\u003dTrue\n\telse:\n\t\tInspectionResult[7]\u003d1\n\tif CaseSWRev\u003d\u003dNone or CaseSWRev\u003d\u003d\"\":\n\t\tself.parent.parent.getChild(\"Wrapper\").getChild(\"Col2\").getChild(\"Warning Labels\").getChild(\"Case SWRev\").position.display\u003dTrue\n\telse:\n\t\tInspectionResult[8]\u003d1\t\t\n\t\t\n\tif 0 not in InspectionResult:\n\t\t\n\t\t##laod tags\n\t\tloadPaths\u003d[\"[FMC1]FMC/Functions/GetNextBatch/ToEIM/CartonerVMSProgramSWName\",\n\t\t\"[FMC1]FMC/Functions/GetNextBatch/ToEIM/CartonerVMSProgramSWRev\",\n\t\t\"[FMC1]FMC/Functions/GetNextBatch/ToEIM/CasePackerVMSProgramSWName\",\n\t\t\"[FMC1]FMC/Functions/GetNextBatch/ToEIM/CasePackerVMSProgramSWRev\",\n\t\t\"[FMC1]FMC/Functions/GetNextBatch/ToEIM/LMSDatabaseSWName\",\n\t\t\"[FMC1]FMC/Functions/GetNextBatch/ToEIM/LMSDatabaseSWRev\",\n\t\t\"[FMC1]FMC/Functions/GetNextBatch/ToEIM/OPCRouterSWName\",\n\t\t\"[FMC1]FMC/Functions/GetNextBatch/ToEIM/OPCRouterSWRev\",\n\t\t\"[FMC1]FMC/Functions/GetNextBatch/ToEIM/UserID\"]\n\t\tloadValues\u003d[CartonerSWName,\n\t\tCartonerSWRev,\n\t\tCaseSWName,\n\t\tCaseSWRev,\n\t\tDBSWName,\n\t\tDBSWRev,\n\t\tOPCSWName,\n\t\tOPCSWRev,\n\t\tUserName]\n\t\tsystem.tag.writeBlocking(loadPaths, loadValues)\n\t\t\n\t\tfunction\u003d\"GetNextBatch\"\n\t\t##trigger  tag\n\t\ttriggerPaths\u003d[\"[FMC1]FMC/Functions/\"+function+\"//Handshaking/cStartCall\"]\n\t\t##reset\n\t\tsystem.tag.writeBlocking(triggerPaths, [0])\n\t\t#time.sleep(1)\n\t\t##trigger\n\t\tsystem.tag.writeBlocking(triggerPaths, [1])\n\t\t\n\t\t\n\t\tsystem.perspective.openPopup(\"Pop1\", \"FMC_Screens/Pop_Ups/Results Box\",showCloseIcon\u003dFalse,title\u003d\"\",\n\t\tresizable\u003dTrue,modal\u003dTrue,draggable\u003dFalse,overlayDismiss\u003dTrue,params\u003d{\"Type\":\"Get Next Batch\",\"Result\":True,\"Function\":function})\n\t\n"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
