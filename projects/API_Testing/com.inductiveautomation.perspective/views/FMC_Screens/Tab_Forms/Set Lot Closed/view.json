                  "config": {
                    "script": "\timport time\n\t##Reset Warning Labels\n\tself.parent.parent.getChild(\"Wrapper\").getChild(\"Col1\").getChild(\"Warning Labels\").getChild(\"Username\").position.display\u003dFalse\n\tself.parent.parent.getChild(\"Wrapper\").getChild(\"Col1\").getChild(\"Warning Labels\").getChild(\"Lot Number\").position.display\u003dFalse\n\t\n\t\n\t##Gather Data\n\tUserName\u003dself.parent.parent.getChild(\"Wrapper\").getChild(\"Col1\").getChild(\"Username\").getChild(\"TextField\").props.text\n\tLotNumber\u003dself.parent.parent.getChild(\"Wrapper\").getChild(\"Col1\").getChild(\"Lot Number\").getChild(\"TextField\").props.text\n\t\n\t\n\t##Data Inspection\n\tInspectionResult\u003d[0,0]\n\t\n\tif UserName\u003d\u003dNone or UserName\u003d\u003d\"\":\n\t\tself.parent.parent.getChild(\"Wrapper\").getChild(\"Col1\").getChild(\"Warning Labels\").getChild(\"Username\").position.display\u003dTrue\n\telse:\n\t\tInspectionResult[0]\u003d1\n\tif LotNumber\u003d\u003dNone or LotNumber\u003d\u003d\"\":\n\t\tself.parent.parent.getChild(\"Wrapper\").getChild(\"Col1\").getChild(\"Warning Labels\").getChild(\"Lot Number\").position.display\u003dTrue\n\telse:\n\t\tInspectionResult[1]\u003d1\n\n\t\t\n\tif 0 not in InspectionResult:\n\t\t\n\t\t##load tags\n\t\tloadPaths\u003d[\"[FMC1]FMC/Functions/SetLotClosed/ToEIM/LotNumber\",\n\t\t\"[FMC1]FMC/Functions/SetLotClosed/ToEIM/UserID\"]\n\t\tloadValues\u003d[LotNumber,\n\t\tUserName]\n\t\tsystem.tag.writeBlocking(loadPaths, loadValues)\n\t\t\n\t\tfunction\u003d\"SetLotClosed\"\n\t\t##trigger  tag\n\t\ttriggerPaths\u003d[\"[FMC1]FMC/Functions/\"+function+\"//Handshaking/cStartCall\"]\n\t\t##reset\n\t\tsystem.tag.writeBlocking(triggerPaths, [0])\n\t\t#time.sleep(1)\n\t\t##trigger\n\t\tsystem.tag.writeBlocking(triggerPaths, [1])\n\t\t\t\n\t\t\n\t\t\n\t\t\n\t\tsystem.perspective.openPopup(\"Pop1\", \"FMC_Screens/Pop_Ups/Results Box\",showCloseIcon\u003dFalse,title\u003d\"\",\n\t\tresizable\u003dTrue,modal\u003dTrue,draggable\u003dFalse,overlayDismiss\u003dTrue,params\u003d{\"Type\":\"Set Lot Closed\",\"Result\":False,\"Function\":function})\n\t\n"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
