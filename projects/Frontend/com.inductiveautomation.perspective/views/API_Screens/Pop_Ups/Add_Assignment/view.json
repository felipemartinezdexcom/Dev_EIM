              {
                "events": {
                  "dom": {
                    "onClick": {
                      "config": {
                        "script": "\n\tusername\u003dself.session.props.auth.user.userName\n\tassignment_name\u003dself.parent.parent.getChild(\"Assignment Name\").getChild(\"TextField\").props.text\n\tequipment_group_id\u003dself.parent.parent.getChild(\"Groups\").getChild(\"Equipment Groups\").getChild(\"Table\").props.selection.data[0].equipment_group_id\n\tfunction_group_id\u003dself.parent.parent.getChild(\"Groups\").getChild(\"Function Groups\").getChild(\"Table\").props.selection.data[0].function_group_id\n\tequipment_group_name\u003dself.parent.parent.getChild(\"Selections\").getChild(\"Selected Equipment Group\").getChild(\"TextArea\").props.text\n\tfunction_group_name\u003dself.parent.parent.getChild(\"Selections\").getChild(\"Selected Function Group\").getChild(\"TextArea\").props.text\n\tdatabase\u003dself.session.custom.EIM_Config_DB\n\t\n\tmessageboxparams\u003d{\"data\":{\"icon\": \"material/info\",\n  \"title\": \"\",\n  \"level\": \"warning\",\n  \"message\": \"\"\n  }\n  }\n\t\n\t##check unique name\n\tparams_name\u003d{\"assignment_name\":assignment_name,\n\t\t\t\t \"database\":database}\n\tcheck_unique_name\u003dsystem.db.execQuery(\"API/Equipment_Manager/Assignments/Check_Unique_Name\", params_name)\n\tif len(check_unique_name)\u003d\u003d0:\n\t\t\t\t\n\t\t##add assignment to table\n\t\tparams\u003d{\"assignment_name\":assignment_name,\n\t\t\t\t\"equipment_group_id\":equipment_group_id,\n\t\t\t\t\"function_group_id\":function_group_id,\n\t\t\t\t\"created_by\":username,\n\t\t\t\t \"database\":database}\n\t\tadd_assignment_result\u003dsystem.db.execQuery(\"API/Equipment_Manager/Assignments/Add\", params)\n\t\tparams[\u0027function_group_name\u0027]\u003dfunction_group_name\n\t\tparams[\u0027equipment_group_name\u0027]\u003dequipment_group_name\n\t\t\n\t\t##check if the assignemnt was inserted(only insert if the FG and EG are not assigned already under a different assignment name)\n\t\tif add_assignment_result[0][\u0027result\u0027]\u003d\u003d1:\n\t\t\n\t\t\t##set equipment_group to assigned\n\t\t\tparams_equipment_group\u003d{\"equipment_group_id\":equipment_group_id,\"assigned\":True,\n\t\t\t\t \t\t\t\t\t\"database\":database}\n\t\t\tsystem.db.execUpdate(\"API/Equipment_Manager/Equipment_Group/Modify_Assign\", params_equipment_group)\n\t\t\t\t\n\t\t\t\t\t\t\n\t\t\t##logEvent add assignet\n\t\t\tlogparams\u003d{\"username\":username,\n\t\t\t\t\"event_type\":\"Add\",\n\t\t\t\t\"before_change\":None,\n\t\t\t\t\"after_change\":str(params),\n\t\t\t\t\"description\":\"Added an assignment between FG {0} and EG {1}.\".format(function_group_name, equipment_group_name)}\n\t\t\tAPI.Functions.log_activity(logparams)\n\t\t\n\t\t\t\n\t\t\tsystem.perspective.sendMessage(\"tablerefresh\")\n\t\t\tsystem.perspective.closePopup(\"\")\n\t\t\t\n\t\telse:\n\t\t\t\t\n\t\t\tmessageboxparams[\u0027data\u0027][\u0027message\u0027]\u003d\"The Function Group: {0} and Equipment Group {1} already have an assignment.\".format(function_group_name, equipment_group_name)\n\t\t\tmessageboxparams[\u0027data\u0027][\u0027title\u0027]\u003d\"Duplicated Assignments\"\n\t\t\n\t\t\t\t\t\t  \n\t\t\tsystem.perspective.openPopup(\"Validated\", \"API_Screens/Pop_Ups/Message_Box\",messageboxparams, showCloseIcon\u003dFalse, draggable\u003dFalse, resizable\u003dFalse, modal\u003dTrue, overlayDismiss\u003dTrue)\n\t\t\n\t\n\telse:\n\n\t\tmessageboxparams[\u0027data\u0027][\u0027message\u0027]\u003d\"An assignment with the same name already exist: {0}. Use a unique name and try again.\".format(assignment_name)\n\t\tmessageboxparams[\u0027data\u0027][\u0027title\u0027]\u003d\"Unable to Delete\"\n\t\n\t\t\t\t\t  \n\t\tsystem.perspective.openPopup(\"Validated\", \"API_Screens/Pop_Ups/Message_Box\",messageboxparams, showCloseIcon\u003dFalse, draggable\u003dFalse, resizable\u003dFalse, modal\u003dTrue, overlayDismiss\u003dTrue)\n\t"
                      },
                      "scope": "G",
                      "type": "script"
                    }
                  }
                },
