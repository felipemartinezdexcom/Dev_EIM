{
  "custom": {},
  "params": {
    "sp_id": "value",
    "sp_name": "GetMachineEQ"
  },
  "propConfig": {
    "params.sp_id": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.sp_name": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 730,
      "width": 1202
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "Pop_Up_Header"
        },
        "position": {
          "shrink": 0
        },
        "propConfig": {
          "props.params.data.title": {
            "binding": {
              "config": {
                "expression": "\"Stored Procedure: \"+{view.params.sp_name}"
              },
              "type": "expr"
            }
          }
        },
        "props": {
          "params": {
            "data": {
              "icon": "material/wysiwyg",
              "level": "popup",
              "message": "value"
            }
          },
          "path": "API_Screens/Templates/Pop_Up_Header"
        },
        "type": "ia.display.view"
      },
      {
        "children": [
          {
            "meta": {
              "name": "SP_Script"
            },
            "propConfig": {
              "props.params.sp_name": {
                "binding": {
                  "config": {
                    "path": "view.params.sp_name"
                  },
                  "type": "property"
                }
              }
            },
            "props": {
              "path": "API_Screens/Embedded_Views/SP_Script"
            },
            "type": "ia.display.view"
          },
          {
            "meta": {
              "name": "SP_Params"
            },
            "position": {
              "tabIndex": 1
            },
            "propConfig": {
              "props.params.sp_name": {
                "binding": {
                  "config": {
                    "path": "view.params.sp_name"
                  },
                  "type": "property"
                }
              }
            },
            "props": {
              "path": "API_Screens/Embedded_Views/SP_Params"
            },
            "type": "ia.display.view"
          }
        ],
        "meta": {
          "name": "TabContainer"
        },
        "position": {
          "basis": "300px",
          "grow": 1
        },
        "props": {
          "tabs": [
            "Script",
            "Parameters"
          ]
        },
        "type": "ia.container.tab"
      },
      {
        "children": [
          {
            "events": {
              "dom": {
                "onClick": {
                  "config": {
                    "script": "\tsystem.perspective.closePopup(\"\")\n\t"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            },
            "meta": {
              "name": "Close Dock"
            },
            "position": {
              "basis": "100px"
            },
            "props": {
              "style": {
                "classes": "Buttons/Classic"
              },
              "text": "Close"
            },
            "type": "ia.input.button"
          }
        ],
        "meta": {
          "name": "Buttons"
        },
        "position": {
          "basis": "35px",
          "shrink": 0
        },
        "props": {
          "justify": "center",
          "style": {
            "gap": 20,
            "marginBottom": 20,
            "marginLeft": 10,
            "marginRight": 10,
            "marginTop": 20
          }
        },
        "type": "ia.container.flex"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "column",
      "style": {
        "classes": "Edges/Boxes_Radious Frames/Standard1 Popups/Background"
      }
    },
    "type": "ia.container.flex"
  }
}